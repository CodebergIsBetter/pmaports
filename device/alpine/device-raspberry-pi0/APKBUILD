# Reference: <https://postmarketos.org/devicepkg>
maintainer="Rudraksha Gupta <rudraksha.gupta@nokia.com>"
pkgname=device-raspberry-pi0
pkgdesc="Raspberry Pi Zero W"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armhf"
# !pmb:crossdirect: this package contains no compiled code, and there is no
# gcc-armhf cross compiler anymore, so build it inside a qemu armhf chroot.
options="!check !archcheck !pmb:crossdirect"
# This device is installed with deviceinfo_alpine_only, so every runtime
# dependency must come from Alpine's repositories and none from postmarketOS.
# No mesa here on purpose. The GPU userspace is only useful to a compositor,
# and depending on it from the base package puts the whole gallium/LLVM stack
# into the headless image, which never composites anything. pmbootstrap adds
# it to the Wayland UI package list instead, so it follows the session rather
# than the board. An install_if on libgbm would look tidier but cannot work:
# there is no package of that name (mesa-gbm merely provides so:libgbm.so.1)
# and nothing in the sway or labwc dependency chain names it directly, so the
# trigger could silently never fire and leave a UI image with no DRI driver.
#
# Keep every comment OUTSIDE the depends string below. Inside double quotes a
# "#" is not a comment: abuild loops over $depends word by word, so each word
# of the comment becomes a dependency - and a quoted phrase inside the comment
# ends the assignment early, which makes the APKBUILD unsourceable and abuild
# die before it builds anything.
#
# dosfstools: /boot is fstab passno 2, so OpenRC checks it on every boot. With
# no fsck.vfat installed that check fails and is then followed by a bogus
# "Filesystems repaired", which makes a real ext4 repair indistinguishable
# from standing noise - and the FAT partition holding the bootloader, kernel,
# initramfs and the wpa_supplicant recovery file could not be repaired on the
# device at all.
#
# sfdisk and partx: grow-rootfs enlarges the root partition on first boot, and
# partx is what makes the running kernel notice the new size. partx is its own
# Alpine subpackage; it is not part of util-linux-misc. Do not use
# util-linux-misc here as a way to get it: it would also drop real
# util-linux binaries over busybox's /sbin/fsck, /sbin/hwclock, /sbin/mkswap,
# /usr/sbin/rfkill and /bin/more applet links, which changes the boot path
# (OpenRC's fsck service) for no reason.
depends="
	alpine-base
	alsa-utils
	avahi
	bluez
	chrony
	dhcpcd
	doas
	dosfstools
	e2fsprogs-extra
	eudev
	iw
	libgpiod
	linux-firmware-brcm
	linux-rpi
	mkinitfs
	openssh
	partx
	raspberrypi-bootloader
	seatd
	sfdisk
	tzdata
	udev-init-scripts
	wireless-regdb
	wpa_supplicant
	"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-openrc
	$pkgname-sway:sway
	$pkgname-xorg:xorg
	$pkgname-xfce4:xfce4
	$pkgname-udev
	"
source="
	deviceinfo
	config.txt
	usercfg.txt
	kernel-cmdline.conf
	modules-load.conf
	95-vchiq-permissions.rules
	doas.conf
	interfaces
	wpa_supplicant.conf
	wifi-boot-config.openrc
	boot-diag.openrc
	grow-rootfs.openrc
	xdg-runtime-dir.sh
	xorg-vc4.conf
	sway-config
	tinydm-env-wayland.sh
	xdg-runtime-dirs.openrc
	xfce4-desktop.xml
	xfce4-power-manager.xml
	10-alpinepi-shutdown.rules
	90-wlan.rules
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/config.txt "$pkgdir"/boot/config.txt
	install -Dm644 "$srcdir"/usercfg.txt "$pkgdir"/boot/usercfg.txt

	# Wi-Fi: wpa_supplicant associates, dhcpcd leases. The credentials are
	# written by "pmbootstrap install --wifi-ssid", or dropped onto the FAT
	# boot partition as /boot/wpa_supplicant.conf.
	install -Dm644 "$srcdir"/xdg-runtime-dir.sh \
		"$pkgdir"/etc/profile.d/99-xdg-runtime-dir.sh

	install -Dm644 "$srcdir"/doas.conf "$pkgdir"/etc/doas.d/10-wheel.conf

	install -Dm644 "$srcdir"/interfaces "$pkgdir"/etc/network/interfaces
	install -Dm600 "$srcdir"/wpa_supplicant.conf \
		"$pkgdir"/etc/wpa_supplicant/wpa_supplicant.conf
	install -Dm755 "$srcdir"/wifi-boot-config.openrc \
		"$pkgdir"/etc/init.d/wifi-boot-config
	install -Dm755 "$srcdir"/boot-diag.openrc "$pkgdir"/etc/init.d/boot-diag
	install -Dm755 "$srcdir"/grow-rootfs.openrc "$pkgdir"/etc/init.d/grow-rootfs

	install -Dm644 "$srcdir"/xorg-vc4.conf \
		"$pkgdir"/etc/X11/xorg.conf.d/20-vc4.conf

	install -Dm644 "$srcdir"/sway-config "$pkgdir"/etc/sway/config.d/10-$pkgname.conf
	install -Dm644 "$srcdir"/tinydm-env-wayland.sh \
		"$pkgdir"/etc/tinydm.d/env-wayland.d/10-$pkgname.sh
	install -Dm755 "$srcdir"/xdg-runtime-dirs.openrc \
		"$pkgdir"/etc/init.d/xdg-runtime-dirs

	install -Dm644 "$srcdir"/95-vchiq-permissions.rules \
		"$pkgdir"/usr/lib/udev/rules.d/95-vchiq-permissions.rules
	install -Dm644 "$srcdir"/90-wlan.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-wlan.rules

	install -Dm644 "$srcdir"/xfce4-desktop.xml \
		"$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
	install -Dm644 "$srcdir"/xfce4-power-manager.xml \
		"$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml
	install -Dm644 "$srcdir"/10-alpinepi-shutdown.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/10-alpinepi-shutdown.rules
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="openrc"

	amove etc/init.d/wifi-boot-config
	amove etc/init.d/boot-diag
	amove etc/init.d/grow-rootfs
	amove etc/init.d/xdg-runtime-dirs
}

xfce4() {
	pkgdesc="$pkgdesc (Xfce session configuration)"
	install_if="$pkgname=$pkgver-r$pkgrel xfdesktop"
	install="$subpkgname.post-install"
	# udisks2 and gvfs: without them Thunar cannot enumerate or mount the SD
	# card or a USB stick, and thunar-volman does nothing.
	depends="
		gvfs
		polkit
		udisks2
		"

	amove etc/xdg/xfce4
	amove usr/share/polkit-1
}

xorg() {
	pkgdesc="$pkgdesc (Xorg configuration)"
	install_if="$pkgname=$pkgver-r$pkgrel xorg-server"

	amove etc/X11
}

sway() {
	pkgdesc="$pkgdesc (sway session)"
	install_if="$pkgname=$pkgver-r$pkgrel sway"
	install="$subpkgname.post-install"
	# A bare "apk add sway" gives you a compositor and nothing to run in it
	depends="
		font-dejavu
		foot
		wmenu
		"

	amove etc/sway
}

