#!/sbin/openrc-run

description="Write a diagnostic report to the FAT boot partition"

# A headless board with no working network and no serial console leaves no way
# to find out why. /boot is FAT, so it can be read on any computer by just
# putting the SD card in it. Keep this cheap: one small file, once per boot.

report="/boot/diag.txt"

depend() {
	need localmount
	# Everything this report comments on must have had its turn first.
	# Without sshd/chronyd/crond/watchdog here, the report was written while
	# they were still starting and listed them as stopped - so a healthy board
	# produced a file byte-for-byte identical to a broken one, which defeats
	# the entire point of writing it.
	after wpa_supplicant dhcpcd tinydm syslog klogd
	after sshd chronyd crond watchdog
}

# Ordering after dhcpcd only means dhcpcd was *started*, not that a lease
# arrived: association plus DHCP on this board takes a few seconds longer than
# the rest of the boot. Wait, bounded, for the steady state so the report
# describes the system a user will actually find - and record the fact if the
# wait times out, because that is itself the most useful line in the file.
wait_for_network() {
	waited=0
	while [ "$waited" -lt 30 ]; do
		state=$(wpa_cli -i wlan0 status 2>/dev/null | sed -n 's/^wpa_state=//p')
		addr=$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}')
		[ "$state" = "COMPLETED" ] && [ -n "$addr" ] && return 0
		sleep 1
		waited=$((waited + 1))
	done
	return 1
}

write_report() {
	if [ "$report_when" = "shutdown" ]; then
		# Never wait at shutdown. The network is being torn down around us,
		# so a wait here can only ever time out: it would add 30 s to every
		# single poweroff and then blame the wifi for an orderly stop.
		net_verdict="not waited for, this is a snapshot taken at shutdown"
	elif wait_for_network; then
		net_verdict="associated with an address after ${waited}s"
	else
		net_verdict="NO ADDRESS after ${waited}s - this is the fault, look at the wifi section"
	fi
	ebegin "Writing $report"
	{
		echo "# Generated by boot-diag on $(date 2>/dev/null) ($report_when)"
		echo "# Read this file by putting the SD card in any computer."
		echo "# Network at the time of writing: $net_verdict"
		echo
		echo "===== uname ====="
		uname -a
		echo
		echo "===== service status ====="
		rc-status --all 2>&1
		echo
		echo "===== network interfaces ====="
		ip addr 2>&1
		echo
		echo "===== routes / dns ====="
		ip route 2>&1
		cat /etc/resolv.conf 2>&1
		echo
		echo "===== wifi ====="
		iw dev 2>&1
		iw dev wlan0 link 2>&1
		wpa_cli -i wlan0 status 2>&1
		echo "--- configured networks (passphrase hash redacted):"
		sed 's/^\(\s*psk=\).*/\1<redacted>/' /etc/wpa_supplicant/wpa_supplicant.conf 2>&1
		echo
		echo "===== regulatory domain ====="
		iw reg get 2>&1
		echo
		echo "===== rfkill ====="
		rfkill list 2>&1
		echo
		echo "===== loaded modules ====="
		lsmod 2>&1
		echo
		echo "===== drm / gpu ====="
		ls -l /dev/dri 2>&1
		echo
		echo "===== session ====="
		ls -ld /run/user/* 2>&1
		echo "--- tinydm session:"
		ls -l /var/lib/tinydm/default-session.desktop 2>&1
		grep -s '^AUTOLOGIN_UID' /etc/conf.d/tinydm 2>&1
		echo "--- sway/session log:"
		for f in /home/*/.local/state/tinydm.log; do
			[ -f "$f" ] && { echo "== $f"; tail -n 60 "$f"; }
		done
		echo
		echo "===== kernel messages (firmware, wifi, vc4, sdio) ====="
		dmesg 2>/dev/null | grep -iE 'brcmfmac|brcmutil|firmware|wlan|sdio|mmc|vc4|drm' | tail -n 80
		echo
		echo "===== syslog tail ====="
		tail -n 120 /var/log/messages 2>&1
	} > "$report" 2>&1
	sync
	eend 0
}

start() {
	report_when="boot"
	write_report
}

# Also write one at shutdown. A board that worked for an hour and then dropped
# off the network leaves no trace otherwise, because the boot-time report was
# written before the problem happened.
stop() {
	report_when="shutdown"
	report="/boot/diag-shutdown.txt"
	write_report
}
